/****************************
  deepClone(value)

  LOGIC
  1. Base case: if value is not an object (primitive, function) or is null,
     return it as is. Nothing nested to copy, and this ends the recursion.
  2. Circular reference: 'seen' is a WeakMap of original -> clone.
     If we already cloned this object, return that clone instead of recursing.
  3. Create an empty container of the same kind: [] for arrays, {} otherwise.
  4. Register the copy in 'seen' BEFORE recursing, so a cycle finds it.
  5. Clone each own key recursively and assign it: copy[key] = deepClone(...).
  6. Return the copy.

  WHY WeakMap: it does not keep the original objects alive (garbage collectable).
  COMPLEXITY: O(n) time, O(n) space, n = total number of values.

  NOT HANDLED YET: Date, RegExp, Map, Set, Symbol keys, class prototypes.
  TESTS: copy !== original, copy.y !== original.y, circular (c.self = c), null inside object.
*****************************/

function deepClone(value, seen = new WeakMap()) {
  if (value === null || typeof value !== 'object') return value;

  if (seen.has(value)) return seen.get(value);

  const copy = Array.isArray(value) ? [] : {};
  seen.set(value, copy);

  for (const key of Object.keys(value)) {
    copy[key] = deepClone(value[key], seen);
  }

  return copy;
}
