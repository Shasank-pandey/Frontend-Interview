/***********
  deepGet(obj, path, defaultValue)   (like lodash _.get)

  LOGIC
  1. Turn the path into an array of keys: use it as is if it is already
     an array, otherwise split a string like 'a.b.c' on dots.
  2. Start with result = obj and loop over the keys.
  3. Before each step, if result is null or undefined there is nothing
     left to read, so return defaultValue.
  4. Otherwise move down one level: result = result[key].
  5. After the loop, if the final value is undefined return defaultValue,
     else return the value.

  COMPLEXITY: O(k) time for k keys, O(k) space for the keys array.
**************/




function deepGet(obj, path, defaultValue) {
  const keys = Array.isArray(path) ? path : path.split('.');
  let result = obj;

  for (const key of keys) {
    if (result === null || result === undefined) {
      return defaultValue;
    }
    result = result[key];
  }

  return result === undefined ? defaultValue : result;
}


const data = {
    user: {
        profile: {
            name: "John Doe",
            address: {
                city: "New York",
            },
        },
    },
};

console.log(deepGet(data, "user.profile.name")); // ✅ "John Doe"
console.log(deepGet(data, "user.profile.age", 30)); // ✅ 30 (default value)
console.log(deepGet(data, ["user", "profile", "address", "city"])); // ✅ "New York"
console.log(deepGet(data, "user.contact.phone", "Not Available")); // ✅ "Not Available"
